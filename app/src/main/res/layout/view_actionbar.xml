<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_small"
        android:paddingEnd="@dimen/space_small">

        <ImageButton
            android:id="@+id/actionbar_close"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="@dimen/space_small"
            android:background="@drawable/background_app_bar_button"
            android:contentDescription="@string/close_page"
            android:padding="@dimen/space_small"
            android:scaleType="center"
            android:src="@drawable/ic_close"
            android:tint="?attr/color_on_app_bar" />

        <TextView
            android:id="@+id/actionbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="?attr/color_on_app_bar"
            android:textSize="@dimen/text_actionbar" />

        <ImageButton
            android:id="@+id/actionbar_menu"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/background_app_bar_button"
            android:contentDescription="@string/more_options"
            android:padding="@dimen/space_small"
            android:scaleType="center"
            android:src="@drawable/ic_more_vert"
            android:tint="?attr/color_on_app_bar" />
    </LinearLayout>
</merge>
