<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView style="@style/FieldLabel" android:layout_marginTop="0dp" android:text="@string/disclaimer_title" />
    <TextView style="@style/BodyText" android:text="@string/disclaimer_body" />
    <TextView style="@style/FieldLabel" android:text="@string/contact_title" />
    <TextView
        android:id="@+id/contact_email"
        style="@style/BodyText"
        android:background="@drawable/background_button"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target"
        android:paddingTop="@dimen/space_small"
        android:paddingBottom="@dimen/space_small"
        android:text="@string/contact_email"
        android:textColor="?attr/color_action"
        android:textSize="@dimen/text_button" />
</LinearLayout>
