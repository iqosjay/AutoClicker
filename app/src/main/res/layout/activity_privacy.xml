<?xml version="1.0" encoding="utf-8"?>
<com.roy.autoclicker.common.widget.ScreenLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical">

    <com.roy.autoclicker.common.widget.Actionbar
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/actionbar_height"
        android:elevation="4dp"
        app:actionbar_title="@string/privacy_title" />

    <ScrollView
        android:id="@+id/privacy_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/space_large">
        <include layout="@layout/content_privacy" />
    </ScrollView>
</com.roy.autoclicker.common.widget.ScreenLayout>
