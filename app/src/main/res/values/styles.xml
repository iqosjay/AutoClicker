<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SectionCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_medium</item>
        <item name="android:background">@drawable/background_panel</item>
        <item name="android:padding">@dimen/space_medium</item>
        <item name="android:orientation">vertical</item>
        <item name="android:elevation">@dimen/elevation_card</item>
    </style>
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:drawablePadding">@dimen/space_medium</item>
        <item name="android:drawableTint">@color/text_primary</item>
    </style>
    <style name="BodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_small</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingExtra">@dimen/space_small</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="FieldLabel" parent="BodyText">
        <item name="android:layout_marginTop">@dimen/space_medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">@dimen/icon_size</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:drawablePadding">@dimen/space_small</item>
        <item name="android:drawableTint">@color/text_secondary</item>
    </style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:layout_marginTop">@dimen/space_small</item>
        <item name="android:paddingStart">@dimen/space_medium</item>
        <item name="android:paddingEnd">@dimen/space_medium</item>
        <item name="android:paddingTop">@dimen/space_small</item>
        <item name="android:paddingBottom">@dimen/space_small</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:background">@drawable/background_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:drawablePadding">@dimen/space_small</item>
        <item name="android:drawableTint">@color/button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_text</item>
    </style>
    <style name="PrimaryButton" parent="ActionButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:background">@drawable/background_button_primary</item>
        <item name="android:textColor">?attr/color_on_button</item>
        <item name="android:drawableTint">?attr/color_on_button</item>
        <item name="android:stateListAnimator">@animator/button_elevation</item>
    </style>
    <style name="NumberInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/field_height</item>
        <item name="android:layout_marginTop">@dimen/space_small</item>
        <item name="android:paddingStart">@dimen/space_medium</item>
        <item name="android:paddingEnd">@dimen/space_medium</item>
        <item name="android:paddingTop">@dimen/space_small</item>
        <item name="android:paddingBottom">@dimen/space_small</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/background_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">4</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">@dimen/text_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>
    <style name="DialogButton" parent="ActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">@dimen/dialog_button_width</item>
        <item name="android:layout_marginTop">0dp</item>
    </style>
    <style name="PopupMenuStyle" parent="android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/background_popup</item>
        <item name="android:popupElevation">@dimen/space_small</item>
    </style>
</resources>
